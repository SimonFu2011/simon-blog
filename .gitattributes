# 统一行尾：仓库内一律 LF，避免 Windows 上 CRLF/LF 反复变动
* text=auto eol=lf

# 明确按二进制处理（不做行尾/编码转换）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.db   binary
*.db-wal binary
*.db-shm binary

# git diff 更友好的语言标注
*.js    text
*.css   text
*.html  text
*.json  text
*.md    text
